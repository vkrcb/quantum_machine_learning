import os
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from scipy.interpolate import interp1d
from scipy.ndimage import uniform_filter1d
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import MinMaxScaler
from qiskit import QuantumCircuit
from qiskit.circuit import Parameter
from qiskit.primitives import Estimator
from qiskit_machine_learning.algorithms import VQR
from qiskit_machine_learning.optimizers import L_BFGS_B

# === Style ===
plt.rcParams['font.family'] = 'Times New Roman'
plt.rcParams['axes.labelweight'] = 'bold'

# === Config ===
base_path = "/home/ashok/Documents/battery_alt_dataset/battery_alt_dataset/regular_alt_batteries"

battery_map = {
    "9.3A": ["battery01.csv", "battery11.csv"],
    "12.9A": ["battery31.csv", "battery22.csv"],
    "14.3A": ["battery23.csv", "battery52.csv"],
    "16.0A": ["battery00.csv", "battery10.csv"],
    "19.0A": ["battery20.csv", "battery30.csv"]
}

color_map = {
    "9.3A": "tab:blue",
    "12.9A": "mediumorchid",
    "14.3A": "limegreen",
    "16.0A": "darkorange",
    "19.0A": "red"
}

NUM_POINTS = 30000
CUTOFF_VOLTAGE = 5

# Quantum Parameter-Shift Sensitivity ===
def quantum_sensitivity(model, x, shift=np.pi/2):
    x = np.array(x, dtype=float)
    weights = model._fit_result.x.copy()
    sensitivities = []

    for i in range(len(weights)):
        shift_vec = np.zeros_like(weights)
        shift_vec[i] = shift

        # forward
        model._fit_result.x = weights + shift_vec
        f_plus = model.predict(x.reshape(1, -1))[0]

        # backward
        model._fit_result.x = weights - shift_vec
        f_minus = model.predict(x.reshape(1, -1))[0]

        grad = (f_plus - f_minus) / 2
        sensitivities.append(abs(grad))

    model._fit_result.x = weights
    return np.array(sensitivities)

# === Storage ===
sensitivity_summary = {}
scatter_data = {}

# === Main Loop ===
for current, files in battery_map.items():

    interpolated_voltages = []
    min_cycle_duration = np.inf

    for file in files:
        df = pd.read_csv(os.path.join(base_path, file))

        df_discharge = df[
            (df["mode"] == -1) &
            (df["voltage_load"] > 5) &
            (df["voltage_load"] < 8.4)
        ].copy()

        df_discharge["cycle"] = (df_discharge["time"].diff() > 10).cumsum()

        for i in range(4):
            cycle = df_discharge[df_discharge["cycle"] == i].copy()

            if len(cycle) > 10:
                cycle["time"] -= cycle["time"].min()
                cycle = cycle.sort_values("time")

                duration = cycle["time"].max()
                min_cycle_duration = min(min_cycle_duration, duration)

                f = interp1d(cycle["time"], cycle["voltage_load"], fill_value="extrapolate")
                interpolated_voltages.append(f)

    if not interpolated_voltages:
        continue

    # === Build dataset ===
    t = np.linspace(0, min_cycle_duration, NUM_POINTS)

    arr = [f(t) for f in interpolated_voltages]
    v = np.mean(arr, axis=0)
    v = np.clip(v, CUTOFF_VOLTAGE, None)
    v = uniform_filter1d(v, size=20)

    current_val = float(current.replace("A", ""))
    current_feature = np.full_like(t, current_val)

    X = np.column_stack((t, current_feature))
    y = v.reshape(-1, 1)

    # === Scaling ===
    scaler_X = MinMaxScaler()
    scaler_y = MinMaxScaler()

    X_scaled = scaler_X.fit_transform(X)
    y_scaled = scaler_y.fit_transform(y)

    X_train, X_test, y_train, y_test = train_test_split(
        X_scaled, y_scaled, test_size=0.2, random_state=42
    )

    # === Quantum Model ===
    x1, x2 = Parameter("x1"), Parameter("x2")
    fm = QuantumCircuit(2)
    fm.ry(x1, 0)
    fm.ry(x2, 1)

    y1, y2 = Parameter("θ1"), Parameter("θ2")
    ansatz = QuantumCircuit(2)
    ansatz.ry(y1, 0)
    ansatz.ry(y2, 1)

    vqr = VQR(
        feature_map=fm,
        ansatz=ansatz,
        optimizer=L_BFGS_B(maxiter=200),
        estimator=Estimator()
    )

    vqr.fit(X_train, y_train.ravel())

    # === Quantum Sensitivity Computation ===
    sample_idx = np.random.choice(len(X_test), min(300, len(X_test)), replace=False)

    sens_list = []
    energies = []

    for x_sample in X_test[sample_idx]:
        sens = quantum_sensitivity(vqr, x_sample)
        sens_list.append(sens)

        energies.append(
            scaler_X.inverse_transform(x_sample.reshape(1, -1))[0][0]
        )

    sens_array = np.array(sens_list)

    # Mean sensitivity per parameter
    mean_sens = np.mean(sens_array, axis=0)

    # Normalize
    norm_sens = mean_sens / (np.sum(mean_sens) + 1e-8)

    sensitivity_summary[current] = norm_sens

    # FIX: use mean over all θ parameters
    scatter_data[current] = (
        np.array(energies),
        np.mean(sens_array, axis=1)
    )

# === Plot 1: Parameter Importance ===
currents = list(sensitivity_summary.keys())

theta1 = [float(sensitivity_summary[c][0]) for c in currents]
theta2 = [float(sensitivity_summary[c][1]) for c in currents]

x = np.arange(len(currents))
width = 0.35

plt.figure(figsize=(10, 6))

plt.bar(x - width/2, theta1, width, label="θ1 (Qubit 0)")
plt.bar(x + width/2, theta2, width, label="θ2 (Qubit 1)")

plt.xticks(x, currents)
plt.ylabel("Normalized Sensitivity")
plt.title("Quantum Circuit Parameter Importance")
plt.legend()
plt.grid(True, linestyle="--", alpha=0.7)

plt.tight_layout()
plt.show()

# === Plot 2: Sensitivity vs Energy ===
plt.figure(figsize=(10, 6))

for current, (energies, sens_vals) in scatter_data.items():

    plt.scatter(
        energies,
        sens_vals,
        color=color_map[current],
        s=20,
        alpha=0.6,
        label=current
    )

    sorted_idx = np.argsort(energies)

    plt.plot(
        np.array(energies)[sorted_idx],
        uniform_filter1d(np.array(sens_vals)[sorted_idx], size=30),
        color=color_map[current],
        linestyle='--'
    )

plt.xlabel("Time")
plt.ylabel("Quantum Sensitivity")

plt.legend(title="Current Levels")
plt.grid(True, linestyle="--", alpha=0.7)

plt.tight_layout()
plt.show()
