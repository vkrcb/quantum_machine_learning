import os
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from scipy.signal import savgol_filter
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
from sklearn.preprocessing import MinMaxScaler
from qiskit.primitives import Estimator
from qiskit import QuantumCircuit
from qiskit.circuit import Parameter
from qiskit_machine_learning.neural_networks import EstimatorQNN
from qiskit_machine_learning.algorithms.regressors import VQR
from qiskit_machine_learning.optimizers import L_BFGS_B

# ... (imports remain unchanged)
from matplotlib.font_manager import FontProperties
# Set Roman style globally
plt.rcParams["font.family"] = "serif"
plt.rcParams["font.serif"] = ["Times New Roman"]
plt.rcParams['axes.labelweight'] = 'bold'
plt.rcParams['xtick.labelsize'] = 12
plt.rcParams['ytick.labelsize'] = 12
# Legend font (Times New Roman, bold)
roman_bold = FontProperties(family='Times New Roman', weight='bold', size=12)

# --- File paths and labels ---
base_path = "/home/ashok/Documents/battery_alt_dataset/battery_alt_dataset/regular_alt_batteries"
csv_files = [
    os.path.join(base_path, "battery40.csv"),
    os.path.join(base_path, "battery50.csv"),
    os.path.join(base_path, "battery41.csv"),
    os.path.join(base_path, "battery51.csv"),
]
labels = ["Battery 1", "Battery 2", "Battery 3", "Battery 4"]
LOAD_CONDITIONS = [(16, 19), (12.9, 16)]  # for Battery 1-2 and Battery 3-4
TIME_LIMIT = 1000

# --- Plot setup ---
fig, axes = plt.subplots(2, 2, figsize=(16, 8))
axes = axes.flatten()
#
for battery_idx, file_path in enumerate(csv_files):
    if not os.path.exists(file_path):
        print(f"File not found: {file_path}")
        continue
    # Read the CSV file
    df = pd.read_csv(file_path)
    df.dropna(subset=["current_load", "voltage_load"], inplace=True)
    # Filter data based on load conditions
    load_min, load_max = LOAD_CONDITIONS[0] if battery_idx < 2 else LOAD_CONDITIONS[1]
    df_filtered = df[
        (df["current_load"] >= load_min) &
        (df["current_load"] <= load_max) &
        (df["mode"] == -1)
    ].copy()

    if df_filtered.empty:
        print(f"No data for {labels[battery_idx]} in range {load_min}-{load_max}A")
        continue

    df_filtered = df_filtered[df_filtered["time"] < df_filtered["time"].min() + TIME_LIMIT]
    df_filtered["elapsed_time"] = df_filtered["time"] - df_filtered["time"].min()

    if len(df_filtered["voltage_load"]) >= 11:
        df_filtered["voltage_load"] = savgol_filter(df_filtered["voltage_load"], 11, 2)

    features = df_filtered[["elapsed_time", "current_load"]].values  # Feature matrix
    target = df_filtered["voltage_load"].values # Target vector
    # Scale features and target
    scaler_X = MinMaxScaler()
    scaler_y = MinMaxScaler()
    X_scaled = scaler_X.fit_transform(features)
    y_scaled = scaler_y.fit_transform(target.reshape(-1, 1)).flatten()
    # Split data into training and testing sets

    X_train, X_test, y_train, y_test = train_test_split(X_scaled, y_scaled, test_size=0.2, random_state=42)

    # QNN circuit
    param_x1, param_x2 = Parameter("x1"), Parameter("x2")
    param_y1, param_y2 = Parameter("y1"), Parameter("y2")
    # Define feature map and ansatz
    feature_map = QuantumCircuit(2)
    feature_map.ry(param_x1, 0)
    feature_map.ry(param_x2, 1)

    ansatz = QuantumCircuit(2)
    ansatz.ry(param_y1, 0)
    ansatz.ry(param_y2, 1)

    qc = QuantumCircuit(2)
    # Compose the feature map and ansatz into a single circuit
    qc.compose(feature_map, inplace=True)
    qc.compose(ansatz, inplace=True)
    estimator=Estimator()
    # Create VQR instance
    vqr = VQR(
        feature_map=feature_map,
        ansatz=ansatz,
        optimizer=L_BFGS_B(maxiter=200),
        estimator=estimator
    )

    print(f"Training {labels[battery_idx]} VQR...")
    # Train VQR
    vqr.fit(X_train, y_train)
    # --- CONFIDENCE INTERVAL CALCULATION ---
    # Training data par residuals calculate kiye gaye hain
    y_train_pred = vqr.predict(X_train)
    y_train_pred_rescaled = scaler_y.inverse_transform(y_train_pred.reshape(-1, 1)).flatten()
    y_train_rescaled = scaler_y.inverse_transform(y_train.reshape(-1, 1)).flatten()
    residuals = y_train_rescaled - y_train_pred_rescaled
    sigma = np.std(residuals) # Standard Deviation of residuals
    z = 1.96   # Z-score for 95% CI/PI

    # Predict and inverse transform (Test Data)
    y_pred = vqr.predict(X_test)
    y_pred_rescaled = scaler_y.inverse_transform(y_pred.reshape(-1, 1)).flatten()
    y_test_rescaled = scaler_y.inverse_transform(y_test.reshape(-1, 1)).flatten()

    mae = mean_absolute_error(y_test_rescaled, y_pred_rescaled)
    rmse = np.sqrt(mean_squared_error(y_test_rescaled, y_pred_rescaled))
    r2 = r2_score(y_test_rescaled, y_pred_rescaled)

    X_test_unscaled = scaler_X.inverse_transform(X_test)
    test_time = X_test_unscaled[:, 0]
    
    # Sorting is essential for fill_between to work correctly
    sorted_idx = np.argsort(test_time)
    sorted_time = test_time[sorted_idx]
    sorted_voltage_pred = y_pred_rescaled[sorted_idx]
    
    # Calculate bounds for the sorted prediction line
    upper_bound = sorted_voltage_pred + z * sigma
    lower_bound = sorted_voltage_pred - z * sigma

    # Plotting
    ax = axes[battery_idx]
    ax.plot(df_filtered["elapsed_time"], df_filtered["voltage_load"],
            label=f"{labels[battery_idx]} Measured", color="gray", lw=3)
    ax.plot(sorted_time, sorted_voltage_pred,
            label=f"{labels[battery_idx]} VQR Predicted", color="red", linestyle="--", lw=2)

    # --- CI AREA Shading ---
    ax.fill_between(
        sorted_time, 
        lower_bound, 
        upper_bound, 
        color='red', 
        alpha=0.25, # Transparency level
       
    )

    ax.set_title(
    f"TEST: {labels[battery_idx]} Load {load_min}-{load_max} A\n"
    f"MAE={mae:.3f}, RMSE={rmse:.3f}, R²={r2:.3f}",
    fontweight='bold', fontsize=12, fontname='Times New Roman'
    )

    
    # Set x and y labels for all plots
    ax.set_xlabel("Time [s]", fontweight='bold', fontsize=13, fontname='Times New Roman')
    ax.set_ylabel("Voltage [V]", fontweight='bold', fontsize=13, fontname='Times New Roman')

    for label in ax.get_xticklabels() + ax.get_yticklabels():
        label.set_fontweight('bold')
        label.set_fontname('Times New Roman')

    # Ensure bottom x-axis ticks are shown even for top row
    ax.tick_params(bottom=True, labelbottom=True)

    ax.grid(True)
    ax.legend(prop=roman_bold)

plt.tight_layout()
plt.show()
