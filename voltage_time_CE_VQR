    feature_map = QuantumCircuit(3, name="fm")
    feature_map.ry(param_x1, 0)
    feature_map.ry(param_x2, 1)
    feature_map.ry(param_x3, 2)
    param_y1 = Parameter("y1")
    param_y2 = Parameter("y2")
    param_y3 = Parameter("y3")
